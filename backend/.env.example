# ============================================
# Supabase Configuration
# ============================================
# Get these from: Supabase Project Settings 鈫?API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_BUCKET=camera_images

# ============================================
# AI / Vision / Recipe Features
# ============================================
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_api_key

# Optional: For additional AI generation features
# POLLINATIONS_API_KEY=your_pollinations_api_key

# ============================================
# Location / Store Finder
# ============================================
# Get from: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key

# ============================================
# Email Notifications
# ============================================
# Get from: https://resend.com/
RESEND_API_KEY=your_resend_api_key
USER_EMAIL=your_email@example.com

# ============================================
# MQTT Broker Configuration
# ============================================
# Configure these to match your MQTT broker
MQTT_BROKER=your_mqtt_broker_ip_or_hostname
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password
MQTT_BASE=fridge
